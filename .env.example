# ===================================================================
# BANKISM — Environment Configuration Example
# Copy this file to .env to configure optional paid LLM integration.
# NOTE: Bankism works 100% out of the box in Rule-Based Fallback Mode
# without any API keys configured!
# ===================================================================

# Optional: Google Gemini API Key for LLM-assisted threat classification
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: OpenAI API Key for GPT-4o-mini classification
OPENAI_API_KEY=your_openai_api_key_here

# Force rule-based fallback even if API keys are present (0 or 1)
BANKISM_FORCE_FALLBACK=0

# Server port configuration
PORT=8000
HOST=0.0.0.0
